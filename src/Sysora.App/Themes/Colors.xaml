<!--
    Sysora palette. The only place where colors are defined: controls and pages refer to these keys (with
    {ThemeResource}) or to the standard Fluent brushes, never to literal colors.

    - Brand: the blue is the application accent, in place of the Windows accent color; the cyan to blue gradient is
      Sysora's signature and appears only on the navigation selection indicator (and in the app icon).
    - Surfaces: background (window, Mica tint, content area) < surface (cards, setting rows) < elevated (secondary
      panels, menus). Text keeps the Fluent text brushes, which adapt to every surface.
    - Metric colors identify a measurement (CPU, memory...); status colors carry a state and are always shown with an
      icon or a label. The two sets never share a color, and the metric set stays apart under color blindness.
    - Status and metric brushes must stay in this top-level dictionary: ThemeBrushes looks them up here for the
      brushes that view models choose by key.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Accent ramp around Sysora blue (#1688E8). Fluent fills with Dark1 in the light theme (white text, 5.7:1) and with
        Light2 in the dark theme (black text, 9.0:1); accent text uses Dark2 and Light3 (7.8:1 and 10:1 on cards).
    -->
    <Color x:Key="SystemAccentColor">#1688E8</Color>
    <Color x:Key="SystemAccentColorLight1">#3B9DF0</Color>
    <Color x:Key="SystemAccentColorLight2">#5CB0F6</Color>
    <Color x:Key="SystemAccentColorLight3">#9AD0FB</Color>
    <Color x:Key="SystemAccentColorDark1">#0F66BD</Color>
    <Color x:Key="SystemAccentColorDark2">#0C5299</Color>
    <Color x:Key="SystemAccentColorDark3">#0A3F78</Color>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Surfaces -->
            <SolidColorBrush x:Key="SysoraBackgroundBrush" Color="#F5F7FA" />
            <SolidColorBrush x:Key="SysoraSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SysoraSurfacePointerOverBrush" Color="#F6F8FB" />
            <SolidColorBrush x:Key="SysoraSurfacePressedBrush" Color="#EFF3F8" />
            <SolidColorBrush x:Key="SysoraElevatedBrush" Color="#E9EEF5" />
            <SolidColorBrush x:Key="SysoraCardStrokeBrush" Color="#DFE5EE" />
            <SolidColorBrush x:Key="SysoraCardStrokePointerOverBrush" Color="#CFD7E3" />
            <SolidColorBrush x:Key="SysoraDividerBrush" Color="#E6EBF2" />
            <SolidColorBrush x:Key="SysoraTrackBrush" Color="#E3E8EF" />
            <AcrylicBrush x:Key="SysoraFlyoutBackgroundBrush" FallbackColor="#FFFFFF" TintColor="#FFFFFF" TintLuminosityOpacity="0.85" TintOpacity="0.6" />
            <AcrylicBrush x:Key="SysoraPaneBackgroundBrush" FallbackColor="#F5F7FA" TintColor="#F5F7FA" TintLuminosityOpacity="0.9" TintOpacity="0.7" />

            <!-- Metric identities (charts, bars, card icons): CVD-checked as a set, distinct from the status colors -->
            <SolidColorBrush x:Key="CpuAccentBrush" Color="#0C72CB" />
            <SolidColorBrush x:Key="MemoryAccentBrush" Color="#A74696" />
            <SolidColorBrush x:Key="GpuAccentBrush" Color="#AF5504" />
            <SolidColorBrush x:Key="DiskAccentBrush" Color="#765BC6" />
            <SolidColorBrush x:Key="NetworkAccentBrush" Color="#129390" />
            <SolidColorBrush x:Key="NetworkSecondaryAccentBrush" Color="#0B6A67" />

            <!-- Status (icons and badges; 4.5:1 or more on cards) -->
            <SolidColorBrush x:Key="StatusNormalBrush" Color="#127A3E" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#8A6400" />
            <SolidColorBrush x:Key="StatusCriticalBrush" Color="#C4312B" />
            <SolidColorBrush x:Key="StatusUnknownBrush" Color="#677284" />
            <SolidColorBrush x:Key="StatusInfoBrush" Color="#46628F" />
            <SolidColorBrush x:Key="StatusNormalBackgroundBrush" Color="#1F127A3E" />
            <SolidColorBrush x:Key="StatusWarningBackgroundBrush" Color="#268A6400" />
            <SolidColorBrush x:Key="StatusCriticalBackgroundBrush" Color="#1FC4312B" />
            <SolidColorBrush x:Key="StatusInfoBackgroundBrush" Color="#1F46628F" />

            <!-- Impact levels (App Impact, Changes): the status scale -->
            <SolidColorBrush x:Key="LevelLowBrush" Color="#127A3E" />
            <SolidColorBrush x:Key="LevelModerateBrush" Color="#46628F" />
            <SolidColorBrush x:Key="LevelHighBrush" Color="#8A6400" />
            <SolidColorBrush x:Key="LevelVeryHighBrush" Color="#C4312B" />

            <!-- Charts -->
            <SolidColorBrush x:Key="ChartGridBrush" Color="#14000000" />
            <SolidColorBrush x:Key="ChartBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ChartCursorBrush" Color="#0F66BD" />

            <!-- Demo mode badge -->
            <SolidColorBrush x:Key="DemoBadgeBackgroundBrush" Color="#FFF4CE" />
            <SolidColorBrush x:Key="DemoBadgeForegroundBrush" Color="#5C3B00" />

            <!-- Native controls, restyled to the Sysora surfaces and palette -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#F5F7FA" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#DFE5EE" />
            <LinearGradientBrush x:Key="NavigationViewSelectionIndicatorForeground" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#0E9F9B" />
                <GradientStop Offset="1" Color="#0F66BD" />
            </LinearGradientBrush>
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="SysoraPaneBackgroundBrush" />
            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ExpanderContentBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#DFE5EE" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="#CFD7E3" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderPressedBrush" Color="#DFE5EE" />
            <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#DFE5EE" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="#E5F1E9" />
            <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="#F6EFDF" />
            <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="#F9E7E6" />
            <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#E9EEF5" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityIconBackground" Color="#127A3E" />
            <SolidColorBrush x:Key="InfoBarWarningSeverityIconBackground" Color="#8A6400" />
            <SolidColorBrush x:Key="InfoBarErrorSeverityIconBackground" Color="#C4312B" />
            <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#46628F" />
            <StaticResource x:Key="FlyoutPresenterBackground" ResourceKey="SysoraFlyoutBackgroundBrush" />
            <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="SysoraFlyoutBackgroundBrush" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#FFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SysoraBackgroundBrush" Color="#10141C" />
            <SolidColorBrush x:Key="SysoraSurfaceBrush" Color="#191F2B" />
            <SolidColorBrush x:Key="SysoraSurfacePointerOverBrush" Color="#1F2633" />
            <SolidColorBrush x:Key="SysoraSurfacePressedBrush" Color="#1C222E" />
            <SolidColorBrush x:Key="SysoraElevatedBrush" Color="#242C3A" />
            <!-- A slightly brighter top edge: the one "glass" touch, static and free to draw. -->
            <LinearGradientBrush x:Key="SysoraCardStrokeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#26FFFFFF" />
                <GradientStop Offset="0.3" Color="#17FFFFFF" />
                <GradientStop Offset="1" Color="#14FFFFFF" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SysoraCardStrokePointerOverBrush" Color="#2BFFFFFF" />
            <SolidColorBrush x:Key="SysoraDividerBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="SysoraTrackBrush" Color="#1FFFFFFF" />
            <AcrylicBrush x:Key="SysoraFlyoutBackgroundBrush" FallbackColor="#242C3A" TintColor="#242C3A" TintLuminosityOpacity="0.9" TintOpacity="0.8" />
            <AcrylicBrush x:Key="SysoraPaneBackgroundBrush" FallbackColor="#191F2B" TintColor="#191F2B" TintLuminosityOpacity="0.9" TintOpacity="0.8" />

            <SolidColorBrush x:Key="CpuAccentBrush" Color="#3892ED" />
            <SolidColorBrush x:Key="MemoryAccentBrush" Color="#C865B5" />
            <SolidColorBrush x:Key="GpuAccentBrush" Color="#D86D16" />
            <SolidColorBrush x:Key="DiskAccentBrush" Color="#9379E7" />
            <SolidColorBrush x:Key="NetworkAccentBrush" Color="#0CA4A0" />
            <SolidColorBrush x:Key="NetworkSecondaryAccentBrush" Color="#5FCFCB" />

            <SolidColorBrush x:Key="StatusNormalBrush" Color="#4FCB7E" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#F0C24E" />
            <SolidColorBrush x:Key="StatusCriticalBrush" Color="#FF8585" />
            <SolidColorBrush x:Key="StatusUnknownBrush" Color="#8C96A6" />
            <SolidColorBrush x:Key="StatusInfoBrush" Color="#9DB6DE" />
            <SolidColorBrush x:Key="StatusNormalBackgroundBrush" Color="#264FCB7E" />
            <SolidColorBrush x:Key="StatusWarningBackgroundBrush" Color="#26F0C24E" />
            <SolidColorBrush x:Key="StatusCriticalBackgroundBrush" Color="#26FF8585" />
            <SolidColorBrush x:Key="StatusInfoBackgroundBrush" Color="#269DB6DE" />

            <SolidColorBrush x:Key="LevelLowBrush" Color="#4FCB7E" />
            <SolidColorBrush x:Key="LevelModerateBrush" Color="#9DB6DE" />
            <SolidColorBrush x:Key="LevelHighBrush" Color="#F0C24E" />
            <SolidColorBrush x:Key="LevelVeryHighBrush" Color="#FF8585" />

            <SolidColorBrush x:Key="ChartGridBrush" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="ChartBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ChartCursorBrush" Color="#5CB0F6" />

            <SolidColorBrush x:Key="DemoBadgeBackgroundBrush" Color="#3D3420" />
            <SolidColorBrush x:Key="DemoBadgeForegroundBrush" Color="#F0C24E" />

            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#10141C" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#1AFFFFFF" />
            <LinearGradientBrush x:Key="NavigationViewSelectionIndicatorForeground" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#12C8C4" />
                <GradientStop Offset="1" Color="#1688E8" />
            </LinearGradientBrush>
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="SysoraPaneBackgroundBrush" />
            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#191F2B" />
            <SolidColorBrush x:Key="ExpanderContentBackground" Color="#191F2B" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="#2BFFFFFF" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderPressedBrush" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="#1B2E2A" />
            <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="#2F2D23" />
            <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="#322329" />
            <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#1F2838" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityIconBackground" Color="#4FCB7E" />
            <SolidColorBrush x:Key="InfoBarWarningSeverityIconBackground" Color="#F0C24E" />
            <SolidColorBrush x:Key="InfoBarErrorSeverityIconBackground" Color="#FF8585" />
            <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#9DB6DE" />
            <StaticResource x:Key="FlyoutPresenterBackground" ResourceKey="SysoraFlyoutBackgroundBrush" />
            <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="SysoraFlyoutBackgroundBrush" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#242C3A" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="SysoraBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SysoraSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SysoraSurfacePointerOverBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SysoraSurfacePressedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SysoraElevatedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SysoraCardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SysoraCardStrokePointerOverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SysoraDividerBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="SysoraTrackBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="SysoraFlyoutBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SysoraPaneBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="CpuAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="MemoryAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GpuAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DiskAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NetworkAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NetworkSecondaryAccentBrush" Color="{ThemeResource SystemColorHotlightColor}" />

            <SolidColorBrush x:Key="StatusNormalBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="StatusCriticalBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="StatusUnknownBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="StatusInfoBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusNormalBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StatusWarningBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StatusCriticalBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StatusInfoBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="LevelLowBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LevelModerateBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LevelHighBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LevelVeryHighBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="ChartGridBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="ChartBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ChartCursorBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="DemoBadgeBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DemoBadgeForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />

            <!-- Native controls keep their own high-contrast colors. -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ExpanderContentBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityIconBackground" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="InfoBarWarningSeverityIconBackground" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="InfoBarErrorSeverityIconBackground" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
