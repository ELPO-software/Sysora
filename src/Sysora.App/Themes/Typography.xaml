<!--
    Text and icon styles, built on the Fluent type ramp. The font is the WinUI default: Segoe UI Variable on Windows 11
    (with its optical sizes), Segoe UI on Windows 10. Value styles switch to tabular digits (both fonts have them):
    a live value then keeps its width from one update to the next.

    Page title 28 · section title 18 · card title 14 semibold · body 14 · secondary and caption 12 · metric value 28 ·
    score 40.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Margin" Value="0,24,0,8" />
    </Style>

    <Style x:Key="CardHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Spaced label above a card's content ("CPU", "WINDOWS"...). -->
    <Style x:Key="EyebrowTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Small caption above a value ("Base speed", "Committed"...). -->
    <Style x:Key="LabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ColumnHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <!-- Main reading of a metric (dashboard tiles, chart headers). -->
    <Style x:Key="LargeValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- A value beside other content, where a full metric value would dominate (disk activity, uptime). -->
    <Style x:Key="CompactValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- The PC Health score. -->
    <Style x:Key="ScoreValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextBlockStyle}">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Icon sizes. -->
    <Style x:Key="SortIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="10" />
    </Style>
    <Style x:Key="SmallIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- Beside a button label or a list title. -->
    <Style x:Key="ButtonIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="CardIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="16" />
    </Style>
    <!-- At the start of a row or an expander header. -->
    <Style x:Key="RowIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="20" />
    </Style>
    <!-- Leading a card that describes one subject (a volume, the uptime, privacy). -->
    <Style x:Key="FeatureIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="24" />
    </Style>
    <Style x:Key="EmptyStateIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

</ResourceDictionary>
