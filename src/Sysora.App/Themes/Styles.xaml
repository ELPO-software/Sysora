<!-- Sysora surfaces and shared layout styles. Colors from Colors.xaml, sizes from Tokens.xaml. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A card: opaque surface with a thin border, on the page background. No shadow: pages hold dozens of cards. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SysoraSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SysoraCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <!-- Column headers of a table that fills a card (Processes, App Impact): a band under the card top edge. -->
    <Style x:Key="TableHeaderStyle" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource SysoraElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SysoraDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <!-- The card radius minus its 1 px border. -->
        <Setter Property="CornerRadius" Value="11,11,0,0" />
    </Style>

    <!-- "Nothing to show yet": a card with a large icon, a title and an explanation, centered. -->
    <Style x:Key="EmptyStateCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="{StaticResource EmptyStatePadding}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

</ResourceDictionary>
