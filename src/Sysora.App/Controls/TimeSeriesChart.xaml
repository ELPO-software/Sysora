<UserControl
    x:Class="Sysora.App.Controls.TimeSeriesChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Sysora.Localization"
    MinHeight="120">

    <Grid RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- No frame around the plot: a recessive grid and a baseline leave the data in front. -->
        <Border Background="{ThemeResource ChartBackgroundBrush}">
            <Grid
                x:Name="Plot"
                Background="Transparent"
                PointerMoved="OnPlotPointerMoved"
                PointerPressed="OnPlotPointerPressed"
                SizeChanged="OnPlotSizeChanged">
                <!-- Dashed grid lines at 25%, 50% and 75% of the scale, solid baseline at 0. -->
                <Grid IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Line Grid.Row="1" VerticalAlignment="Top" Stretch="Fill" Stroke="{ThemeResource ChartGridBrush}" StrokeDashArray="2,3" StrokeThickness="1" X2="1" />
                    <Line Grid.Row="2" VerticalAlignment="Top" Stretch="Fill" Stroke="{ThemeResource ChartGridBrush}" StrokeDashArray="2,3" StrokeThickness="1" X2="1" />
                    <Line Grid.Row="3" VerticalAlignment="Top" Stretch="Fill" Stroke="{ThemeResource ChartGridBrush}" StrokeDashArray="2,3" StrokeThickness="1" X2="1" />
                    <Border Grid.Row="3" BorderBrush="{ThemeResource ChartGridBrush}" BorderThickness="0,0,0,1" />
                </Grid>

                <Path x:Name="AreaPath" IsHitTestVisible="False" />
                <Path x:Name="LinePath" StrokeThickness="2" StrokeLineJoin="Round" IsHitTestVisible="False" />
                <!-- A second series is dashed, so the two lines differ by more than their color. -->
                <Path x:Name="SecondaryLinePath" StrokeDashArray="3,2" StrokeThickness="2" StrokeLineJoin="Round" IsHitTestVisible="False" />

                <!-- Replay: event markers along the top edge and the cursor (hidden unless set). -->
                <Path x:Name="MarkerPath" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" IsHitTestVisible="False" />
                <Rectangle
                    x:Name="CursorLine"
                    Width="2"
                    HorizontalAlignment="Left"
                    Fill="{ThemeResource ChartCursorBrush}"
                    IsHitTestVisible="False"
                    RadiusX="1"
                    RadiusY="1"
                    Visibility="Collapsed">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="CursorTransform" />
                    </Rectangle.RenderTransform>
                </Rectangle>

                <TextBlock
                    x:Name="MaximumLabel"
                    Margin="4,4,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Style="{StaticResource LabelTextStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Visibility="{x:Bind ShowAxisLabels, Mode=OneWay}">
            <TextBlock x:Name="WindowLabel" Style="{StaticResource LabelTextStyle}" />
            <TextBlock HorizontalAlignment="Right" Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Common_Now}" />
        </Grid>
    </Grid>
</UserControl>
